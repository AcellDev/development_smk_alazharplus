NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL. Replace placeholders locally; never commit real credentials.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/smk_alazhar_ppdb_lms
PGSSL=false

# Uploaded documents stay outside the public web root.
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_SIZE_BYTES=5242880
PRIVATE_UPLOAD_DIR=./var/private-uploads
PRIVATE_UPLOAD_MAX_BYTES=10485760

# Development-only: password bersama untuk akun seed; seed menolak NODE_ENV=production.
SEED_DEMO_PASSWORD=DemoOnly-ChangeMe-2026!
